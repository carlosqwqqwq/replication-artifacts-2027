 impl Vmm {
+    /// Emit the RVOBS1 mailbox at the exact guest termination point.
+    ///
+    /// Bare-metal targets cannot rely on a host syscall to transport the
+    /// frame. Keeping this read in the VMM makes RAX consume the same guest
+    /// memory contract as Renode/RVVM/Unicorn, while the explicit tohost line
+    /// preserves the protocol outcome separately from the architectural frame.
+    fn emit_riscv_observation(&self, state: &crate::cpu::RiscVCpuState) {
+        const MAGIC: &[u8; 8] = b"RVOBS1\0\0";
+        const HEADER_SIZE: usize = 280;
+        const MEMORY_SIZE_OFFSET: usize = 272;
+        const MAX_MEMORY_SIZE: u64 = 1 << 24;
+
+        let memory = self.guest_mem.memory();
+        let mailbox = self
+            .boot_info
+            .as_riscv()
+            .and_then(|info| info.observation_addr);
+        let frame = mailbox.and_then(|address| {
+            let mut header = vec![0u8; HEADER_SIZE];
+            memory
+                .read_slice(&mut header, vm_memory::GuestAddress(address))
+                .ok()?;
+            if &header[..8] != MAGIC {
+                return None;
+            }
+            let checkpoint = u64::from_le_bytes(header[8..16].try_into().ok()?);
+            let memory_size = u64::from_le_bytes(
+                header[MEMORY_SIZE_OFFSET..HEADER_SIZE].try_into().ok()?,
+            );
+            if checkpoint == 0 || checkpoint & 1 != 0 || memory_size > MAX_MEMORY_SIZE {
+                return None;
+            }
+            let total = HEADER_SIZE.checked_add(usize::try_from(memory_size).ok()?)?;
+            let mut frame = vec![0u8; total];
+            memory
+                .read_slice(&mut frame, vm_memory::GuestAddress(address))
+                .ok()?;
+            Some(frame)
+        });
+
+        if let Some(frame) = frame {
+            let encoded: String = frame.iter().map(|byte| format!("{byte:02x}")).collect();
+            println!("RQ1_RVOBS1={encoded}");
+        } else {
+            debug!(?mailbox, "RISC-V terminated without a valid RVOBS1 mailbox");
+        }
+
+        if let Some(tohost) = state.regs.tohost_addr {
+            let mut raw = [0u8; 8];
+            if memory
+                .read_slice(&mut raw, vm_memory::GuestAddress(tohost))
+                .is_ok()
+            {
+                let value = u64::from_le_bytes(raw);
+                println!("RQ1_TOHOST_VALUE={value}");
+                if value != 0 {
+                    println!("RQ1_TOHOST");
+                }
+            }
+        }
+        let _ = std::io::stdout().flush();
+    }
+
