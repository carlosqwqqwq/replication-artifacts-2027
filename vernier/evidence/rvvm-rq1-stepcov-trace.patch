 // Pauses hart in a consistent state, terminates vCPU thread
 void riscv_hart_pause(rvvm_hart_t* vm);
+// Executes exactly one guest instruction while the hart is paused
+void riscv_hart_step(rvvm_hart_t* vm);
+// Writes one guest PC to the optional RQ1 trace stream.
+void rq1_trace_instruction(rvvm_addr_t pc);
