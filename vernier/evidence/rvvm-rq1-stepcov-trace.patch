diff --git a/src/cpu/riscv_hart.c b/src/cpu/riscv_hart.c
--- a/src/cpu/riscv_hart.c
+++ b/src/cpu/riscv_hart.c
@@
 #include <rvvm/rvvm.h>
+#include <stdio.h>
@@
 void riscv_hart_pause(rvvm_hart_t* vm)
 {
     riscv_hart_queue_pause(vm);
     thread_join(vm->thread);
     vm->thread = NULL;
 }
+
+void riscv_hart_step(rvvm_hart_t* vm)
+{
+    atomic_store_uint32_ex(&vm->running, false, ATOMIC_RELAXED);
+    riscv_run_till_event(vm);
+    if (vm->trap) {
+        vm->registers[RISCV_REG_PC] = vm->trap_pc;
+        vm->trap = false;
+    }
+}
+
+void rq1_trace_instruction(rvvm_addr_t pc)
+{
+    static FILE* trace;
+    static bool attempted;
+    if (attempted) {
+        if (trace) {
+            fprintf(trace, "INS 0x%llx\n", (unsigned long long)pc);
+            fflush(trace);
+        }
+        return;
+    }
+    attempted = true;
+    const char* path = rvvm_getarg("rq1-trace");
+    if (!path || !*path) {
+        return;
+    }
+    trace = fopen(path, "wb");
+    if (!trace) {
+        rvvm_warn("Failed to open RQ1 trace %s", path);
+        return;
+    }
+    setvbuf(trace, NULL, _IOLBF, 0);
+    fprintf(trace, "INS 0x%llx\n", (unsigned long long)pc);
+    fflush(trace);
+}
diff --git a/src/cpu/riscv_hart.h b/src/cpu/riscv_hart.h
